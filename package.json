{
  "name": "villa-lago-casino-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim:showdown": "vitest run --config vitest.sim.config.ts sim/showdown.sim.ts",
    "sim:abyss": "vitest run --config vitest.sim.config.ts sim/abyss.sim.ts",
    "sim:brazil": "vitest run --config vitest.sim.config.ts sim/brazil.sim.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
